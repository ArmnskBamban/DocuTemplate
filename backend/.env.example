# PraktiKit Backend Configuration
# Copy this to .env and customize as needed.

# File upload limits
MAX_UPLOAD_SIZE=26214400  # 25 MB in bytes

# Session management
SESSION_TTL=3600  # 60 minutes (1 hour) - increased from default 30 min
TEMP_DIRECTORY=/tmp/praktikit  # Base directory for temporary files

# Classification confidence thresholds
AUTO_THRESHOLD=0.90       # Confidence >= 0.90: automatic handling
REVIEW_THRESHOLD=0.70     # Confidence 0.70-0.89: automatic but flag for review

# Content leak detection
STRICT_LEAK_CHECK=true                # Fail generation if old content detected
LEAK_SIMILARITY_THRESHOLD=0.6         # Shingle overlap ratio (0.0-1.0)

# Optional AI layer
AI_ENABLED=false                      # Enable LLM-based classification (not implemented yet)
# AI_MODEL=gpt-4o-mini                # Model name (when AI_ENABLED=true)
# AI_API_KEY=sk-...                   # API key (when AI_ENABLED=true)

# Logging
LOG_LEVEL=INFO                        # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Production settings (optional)
# CORS_ORIGINS=http://localhost:3000,https://praktikit.example.com  # Comma-separated allowed origins
# SENTRY_DSN=https://...              # Sentry error tracking
