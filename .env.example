# PraktiKit configuration — copy to .env and adjust as needed.
# All values are optional; sensible defaults are applied in praktikit/core/config.py.

# --- Upload limits ---
# Maximum accepted upload size (bytes). Default: 26214400 (25 MB).
MAX_UPLOAD_SIZE=26214400

# --- Processing ---
# Where to place temporary working directories. Default: system temp dir.
TEMP_DIRECTORY=

# Seconds before an idle processing session expires. Default: 1800 (30 min).
SESSION_TTL=1800

# --- Detection thresholds (0.0–1.0) ---
# Confidence at/above which an element is handled automatically. Default: 0.90.
AUTO_THRESHOLD=0.90
# Confidence at/above which an element is auto-handled but flagged for review. Default: 0.70.
REVIEW_THRESHOLD=0.70

# --- Safety ---
# If true, generation fails when potential old-content leaks are detected. Default: true.
STRICT_LEAK_CHECK=true
# Minimum shared-shingle ratio to consider text a content leak (0.0–1.0). Default: 0.6.
LEAK_SIMILARITY_THRESHOLD=0.6

# --- Optional AI layer (disabled by default; core works fully without it) ---
AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=

# --- Logging ---
# One of: DEBUG, INFO, WARNING, ERROR. Avoid DEBUG in production (no PII is ever logged).
LOG_LEVEL=INFO
